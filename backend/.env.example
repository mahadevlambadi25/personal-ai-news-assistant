# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Leave blank in development to auto-launch in-memory database)
# In production, provide your MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/personal_news
MONGODB_URI=

# Authentication (Change in production!)
JWT_SECRET=super_secret_jwt_key_personal_news_assistant_2026_dev
JWT_EXPIRES_IN=7d

# AI Engine (OpenAI API key - If omitted, LocalFallbackAIService operates seamlessly)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# News Providers (Optional - RSS feeds function out of the box without keys)
NEWS_API_KEY=

# Meta WhatsApp Cloud API (Optional - Webhook works for testing without live credentials)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=news_assistant_verify_token_dev
WHATSAPP_API_VERSION=v20.0
